# Cloudflare Pages headers. Hashed assets are immutable; the page itself is always revalidated.
# Each rule but /* is written twice: for the page at a domain's root, and for the page under /titanic/, its public
# address (package.json's homepage). /* already covers every path, the root's and /titanic/'s alike. The app
# (app/main.js) answers titanic://app/ with these rules; its paths never begin with /titanic/.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/index.html
  Cache-Control: no-cache

/titanic/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/titanic/
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/titanic/version.json
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/titanic/manifest.webmanifest
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/titanic/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/titanic/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400

/titanic/icons/*
  Cache-Control: public, max-age=86400
