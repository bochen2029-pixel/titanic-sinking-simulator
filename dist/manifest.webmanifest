{
  "name": "Titanic Sinking Simulator",
  "short_name": "Titanic",
  "description": "A flooding model of RMS Titanic that computes the sinking instead of animating it.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
